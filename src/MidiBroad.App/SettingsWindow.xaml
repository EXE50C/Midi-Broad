<Window x:Class="MidiBroad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Midi Broad — Settings"
        Width="660"
        Height="780"
        MinWidth="600"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="26,24,26,10">
            <TextBlock Text="Settings" Style="{StaticResource CaptionText}" />
            <TextBlock Text="Make it yours." Style="{StaticResource H1Text}" FontSize="26" Margin="0,2,0,0" />
            <TextBlock Text="Changes are saved when you press Save."
                       Style="{StaticResource MutedText}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,8,26,10">
            <StackPanel>
                <!-- Virtual device -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="VIRTUAL MIDI DEVICE" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="This is the name your DAW will see." Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                        <TextBox x:Name="VirtualNameBox" Style="{StaticResource ModernTextBox}" MaxLength="64" />
                        <TextBlock x:Name="VirtualNameHintText"
                                   Text="Renaming recreates the endpoint. Re-select it in your DAW if needed."
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   Margin="2,7,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource CaptionText}" />
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Theme" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeCombo" Style="{StaticResource ModernComboBox}" Width="150" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Language" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageCombo"
                                      Style="{StaticResource ModernComboBox}"
                                      Width="150"
                                      HorizontalAlignment="Right"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="LanguageCombo_SelectionChanged" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Accent" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <StackPanel x:Name="AccentPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Background" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BrowseBackgroundButton" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11" Content="Choose…" Click="BrowseBackgroundButton_Click" />
                                <Button x:Name="ClearBackgroundButton" Style="{StaticResource GhostButton}" Padding="9,6" FontSize="11" Content="Clear" Click="ClearBackgroundButton_Click" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="BackgroundPathText" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="BEHAVIOR" Style="{StaticResource CaptionText}" />
                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource SwitchToggle}" Content="Start with Windows" Margin="0,12,0,0" />
                        <CheckBox x:Name="AutoReconnectCheck" Style="{StaticResource SwitchToggle}" Content="Reconnect the same keyboard" Margin="0,10,0,0" />
                        <CheckBox x:Name="ShowLabelsCheck" Style="{StaticResource SwitchToggle}" Content="Show key labels on the piano" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Config file -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="CONFIG FILE" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="Mappings, virtual port name, theme and behavior live in one JSON file."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfigPathText"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Content="Export…" Click="ExportConfigButton_Click" />
                            <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11" Content="Import…" Click="ImportConfigButton_Click" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ConfigStatusText"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Velocity -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="VELOCITY" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="VelocityModeCombo" Style="{StaticResource ModernComboBox}" Width="120" Height="30" HorizontalAlignment="Right" FontSize="11.5" SelectionChanged="VelocityModeCombo_SelectionChanged" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock x:Name="FixedVelocityLabel" Text="Fixed velocity" Style="{StaticResource BodyText}" />
                            <TextBlock x:Name="FixedVelocityText" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="FixedVelocitySlider" Minimum="1" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="FixedVelocitySlider_ValueChanged" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="MinVelocityLabel" Text="Minimum" Style="{StaticResource BodyText}" />
                            <TextBlock x:Name="MinVelocityText" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="MinVelocitySlider" Minimum="1" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="MinVelocitySlider_ValueChanged" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="MaxVelocityLabel" Text="Maximum" Style="{StaticResource BodyText}" />
                            <TextBlock x:Name="MaxVelocityText" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="MaxVelocitySlider" Minimum="1" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,3,0,0" ValueChanged="MaxVelocitySlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- Pitch bend -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="PITCH BEND" Style="{StaticResource CaptionText}" />
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Key" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="PitchBendKeyCombo" Style="{StaticResource ModernComboBox}" Width="160" HorizontalAlignment="Right" DisplayMemberPath="Name" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Range" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="PitchBendRangeCombo" Style="{StaticResource ModernComboBox}" Width="160" HorizontalAlignment="Right" DisplayMemberPath="Label" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Direction" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="PitchBendDirectionCombo" Style="{StaticResource ModernComboBox}" Width="160" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Hold the key to bend; release it to return to center."
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="MIDI BROAD  ·  Windows 11  ·  Windows MIDI Services"
                           Style="{StaticResource MutedText}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,4" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="26,14">
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Padding="18,9" Click="CancelButton_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Padding="24,9" Margin="8,0,0,0" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
