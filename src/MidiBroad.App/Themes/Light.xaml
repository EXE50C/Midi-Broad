<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#7C3AED</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F3F8" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FCFCFE" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F7F5FF" />
    <SolidColorBrush x:Key="InputBrush" Color="#F7F7FB" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E5EE" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CDD1DE" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14161E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#98A2B3" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />

    <SolidColorBrush x:Key="PianoWhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PianoWhiteActiveBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="PianoBlackBrush" Color="#1B1D26" />
    <SolidColorBrush x:Key="PianoBlackActiveBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="PianoLineBrush" Color="#CDD1DE" />
    <SolidColorBrush x:Key="PianoLabelBrush" Color="#8A91A3" />
    <SolidColorBrush x:Key="PianoActiveTextBrush" Color="#2E1065" />

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EDE9FE" Offset="0" />
        <GradientStop Color="#F1F5FF" Offset="0.52" />
        <GradientStop Color="#F7F7FB" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#0891B2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6F2F3F8" Offset="0" />
        <GradientStop Color="#B0F1F5FF" Offset="0.58" />
        <GradientStop Color="#99F7F7FB" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="8" Opacity="0.10" Color="#1F2937" />
</ResourceDictionary>
