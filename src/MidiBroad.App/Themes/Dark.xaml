<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#8B5CF6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9D7BF8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2144" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#090B10" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0E1118" />
    <SolidColorBrush x:Key="CardBrush" Color="#141821" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1B202C" />
    <SolidColorBrush x:Key="InputBrush" Color="#10141D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#252B38" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#343C4D" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B95A9" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F6A7F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />

    <SolidColorBrush x:Key="PianoWhiteBrush" Color="#F2F3F7" />
    <SolidColorBrush x:Key="PianoWhiteActiveBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="PianoBlackBrush" Color="#151924" />
    <SolidColorBrush x:Key="PianoBlackActiveBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="PianoLineBrush" Color="#2A3040" />
    <SolidColorBrush x:Key="PianoLabelBrush" Color="#6B7285" />
    <SolidColorBrush x:Key="PianoActiveTextBrush" Color="#2E1065" />

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#241B45" Offset="0" />
        <GradientStop Color="#101728" Offset="0.52" />
        <GradientStop Color="#0B1019" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6090B10" Offset="0" />
        <GradientStop Color="#B0101728" Offset="0.58" />
        <GradientStop Color="#99090B10" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="10" Opacity="0.28" Color="#000000" />
</ResourceDictionary>
