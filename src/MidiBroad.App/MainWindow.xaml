<Window x:Class="MidiBroad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MidiBroad.Controls"
        Title="Midi Broad"
        Width="1220"
        Height="840"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="282" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="22,24,22,18">

                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentGradientBrush}">
                                <TextBlock Text="MB"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MIDI BROAD" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="KEYBOARD → MIDI" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="SettingsButton_Click"
                                ToolTip="Settings"
                                Content="⚙"
                                FontSize="15" />
                    </Grid>

                    <Border Style="{StaticResource ChipBorder}" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="VirtualStatusDot" Width="6" Height="6" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="VirtualStatusChipText" Text="STARTING" Style="{StaticResource CaptionText}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0" Padding="0,0,4,0">
                    <StackPanel>
                        <!-- Virtual endpoint card -->
                        <Border Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="VIRTUAL PORT" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="VirtualNameText"
                                           Text="Midi Broad"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="VirtualStatusText"
                                           Text="Starting MIDI service…"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Device -->
                        <TextBlock Text="INPUT DEVICE" Style="{StaticResource CaptionText}" Margin="2,22,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeviceCombo"
                                      Grid.Column="0"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="DeviceCombo_SelectionChanged" />
                            <Button x:Name="RefreshDevicesButton"
                                    Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Height="38"
                                    Width="36"
                                    ToolTip="Refresh devices"
                                    Click="RefreshDevicesButton_Click">
                                <TextBlock Text="↻" FontSize="17" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DeviceDetailText"
                                   Text="No keyboard selected"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Margin="2,7,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Listen -->
                        <Button x:Name="ListenButton"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,16,0,0"
                                Click="ListenButton_Click"
                                Content="Start listening" />
                        <Border Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,8"
                                Margin="0,9,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RELEASE" Style="{StaticResource CaptionText}" FontSize="9.5" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0">
                                        <TextBlock Text="CTRL + ALT + SHIFT + F12"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Fixed hotkey · works while listening"
                                           Style="{StaticResource MutedText}"
                                           FontSize="9.5"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="Shift L/R = octave (hold) · ←/→ = bend · ↑/↓ = velocity"
                                           Style="{StaticResource MutedText}"
                                           FontSize="9"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="F1–F4 = latch soft / sostenuto / sustain / legato pedals"
                                           Style="{StaticResource MutedText}"
                                           FontSize="9"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="If keys don't respond, switch to English input mode."
                                           Style="{StaticResource MutedText}"
                                           FontSize="9"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ThinSeparator}" />

                        <!-- Preset -->
                        <TextBlock Text="MAPPING PRESET" Style="{StaticResource CaptionText}" />
                        <ComboBox x:Name="PresetCombo"
                                  Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="Name"
                                  Margin="0,8,0,0"
                                  SelectionChanged="PresetCombo_SelectionChanged" />
                        <TextBlock x:Name="PresetDescriptionText"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Margin="2,6,0,0" />

                        <!-- Octave / transpose -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="OCTAVE" Style="{StaticResource CaptionText}" />
                                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,7,0,0">
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="0" Click="OctaveDown_Click" Content="−" FontSize="16" />
                                        <TextBlock x:Name="OctaveText" Grid.Column="1" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="0" Click="OctaveUp_Click" Content="+" FontSize="15" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TRANSPOSE" Style="{StaticResource CaptionText}" />
                                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,7,0,0">
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="0" Click="TransposeDown_Click" Content="−" FontSize="16" />
                                        <TextBlock x:Name="TransposeText" Grid.Column="1" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="0" Click="TransposeUp_Click" Content="+" FontSize="15" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Velocity -->
                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="VELOCITY" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="VelocityModeCombo"
                                      Style="{StaticResource ModernComboBox}"
                                      Width="100"
                                      Height="28"
                                      HorizontalAlignment="Right"
                                      FontSize="11"
                                      SelectionChanged="VelocityModeCombo_SelectionChanged" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Base" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock x:Name="VelocityBaseText" Text="100" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="VelocityBaseSlider"
                                Minimum="1" Maximum="127"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,2,0,0"
                                ValueChanged="VelocityBaseSlider_ValueChanged" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Humanize" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock x:Name="HumanizeText" Text="±20" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="HumanizeSlider"
                                Minimum="0" Maximum="40"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,2,0,0"
                                ValueChanged="HumanizeSlider_ValueChanged" />

                        <TextBlock Text="Theme, pitch bend and more are in Settings."
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   Margin="2,14,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="MIDI BROAD  ·  v0.1"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   Margin="2,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================== MAIN ============================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="32,28,32,0">
                <StackPanel>
                    <TextBlock Text="LIVE PERFORMANCE" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="Play something." Style="{StaticResource H1Text}" Margin="0,2,0,0" />
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text="Your spare keyboard is now a MIDI instrument."
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Style="{StaticResource ChipBorder}" Margin="0,0,8,0">
                        <TextBlock x:Name="ChannelChipText" Text="MIDI CH 1" Style="{StaticResource CaptionText}" />
                    </Border>
                    <Border Style="{StaticResource ChipBorder}" Margin="0,0,8,0">
                        <TextBlock x:Name="ModeChipText" Text="SOFT CAPTURE" Style="{StaticResource CaptionText}" />
                    </Border>
                    <Button x:Name="PanicButton"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            Click="PanicButton_Click"
                            Content="PANIC"
                            FontSize="10.5"
                            ToolTip="Send All Notes Off and center pitch bend" />
                </StackPanel>
            </Grid>

            <!-- Hero -->
            <Border Grid.Row="1"
                    Margin="32,20,32,18"
                    CornerRadius="22"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource HeroGradientBrush}">
                <Grid>
                    <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.45" />
                    <Border Background="{DynamicResource HeroOverlayBrush}" />
                    <Ellipse Width="560" Height="560"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="1"
                             Opacity="0.18"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,-120,0" />
                    <Ellipse Width="380" Height="380"
                             Stroke="#22D3EE"
                             StrokeThickness="1"
                             Opacity="0.16"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,-30,0" />
                    <Ellipse Width="220" Height="220"
                             Fill="{DynamicResource AccentBrush}"
                             Opacity="0.06"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,40,0" />

                    <Grid Margin="34,28,34,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="NOW PLAYING" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse x:Name="ListeningPulse" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ListeningStateText" Text="IDLE" Style="{StaticResource CaptionText}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingText"
                                       Text="—"
                                       FontSize="54"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NowPlayingSubText"
                                       Text="Select a keyboard and press Start listening."
                                       Style="{StaticResource MutedText}"
                                       FontSize="13"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,34,0">
                                <TextBlock Text="ACTIVE NOTES" Style="{StaticResource CaptionText}" FontSize="9.5" />
                                <TextBlock x:Name="ActiveNotesText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,34,0">
                                <TextBlock Text="LAST VELOCITY" Style="{StaticResource CaptionText}" FontSize="9.5" />
                                <TextBlock x:Name="LastVelocityText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,34,0">
                                <TextBlock Text="NOTES PLAYED" Style="{StaticResource CaptionText}" FontSize="9.5" />
                                <TextBlock x:Name="NotesPlayedText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="LAST INPUT" Style="{StaticResource CaptionText}" FontSize="9.5" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LastInputText"
                                               Text="—"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="180" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <TextBlock Text="PEDALS" Style="{StaticResource CaptionText}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border x:Name="Pedal0"
                                            Width="60" Height="28"
                                            CornerRadius="8"
                                            Background="#FBBF24"
                                            Opacity="0.32"
                                            Cursor="Hand"
                                            Tag="0"
                                            ToolTip="F1 — soft pedal (CC 67)"
                                            MouseLeftButtonDown="Pedal_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="F1" FontSize="8.5" FontWeight="Bold" Foreground="#111827" />
                                            <TextBlock Text="SOFT" FontSize="8" FontWeight="SemiBold" Foreground="#111827" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Pedal1"
                                            Width="60" Height="28"
                                            CornerRadius="8"
                                            Background="#22D3EE"
                                            Opacity="0.32"
                                            Cursor="Hand"
                                            Tag="1"
                                            Margin="4,0,0,0"
                                            ToolTip="F2 — sostenuto pedal (CC 66)"
                                            MouseLeftButtonDown="Pedal_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="F2" FontSize="8.5" FontWeight="Bold" Foreground="#111827" />
                                            <TextBlock Text="SOST" FontSize="8" FontWeight="SemiBold" Foreground="#111827" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Pedal2"
                                            Width="60" Height="28"
                                            CornerRadius="8"
                                            Background="#34D399"
                                            Opacity="0.32"
                                            Cursor="Hand"
                                            Tag="2"
                                            Margin="4,0,0,0"
                                            ToolTip="F3 — sustain pedal (CC 64)"
                                            MouseLeftButtonDown="Pedal_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="F3" FontSize="8.5" FontWeight="Bold" Foreground="#111827" />
                                            <TextBlock Text="SUSTAIN" FontSize="8" FontWeight="SemiBold" Foreground="#111827" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Pedal3"
                                            Width="60" Height="28"
                                            CornerRadius="8"
                                            Background="#F472B6"
                                            Opacity="0.32"
                                            Cursor="Hand"
                                            Tag="3"
                                            Margin="4,0,0,0"
                                            ToolTip="F4 — legato pedal (CC 68)"
                                            MouseLeftButtonDown="Pedal_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="F4" FontSize="8.5" FontWeight="Bold" Foreground="#111827" />
                                            <TextBlock Text="LEGATO" FontSize="8" FontWeight="SemiBold" Foreground="#111827" Margin="3,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Piano -->
            <Border Grid.Row="2"
                    Margin="32,0,32,26"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18,14,18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PIANO" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="4" Padding="6,2" Margin="9,0,0,0">
                                <TextBlock x:Name="PianoRangeText" Text="C3 — C5" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="PianoHintText"
                                       Text="Keys light up as you play"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <Button x:Name="EditKeysButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="10.5"
                                    Content="Edit keys"
                                    Click="EditKeysButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <controls:PianoKeyboard x:Name="Piano"
                                                Height="172"
                                                NotePressed="Piano_NotePressed"
                                                NoteReleased="Piano_NoteReleased" />
                        <Canvas x:Name="KeyEditOverlay"
                                Visibility="Collapsed"
                                Background="#01000000"
                                ClipToBounds="True" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

